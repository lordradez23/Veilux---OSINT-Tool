# VEILUX-NG Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Optional API Keys ─────────────────────────────────────────────────────────
IPINFO_TOKEN=
OPENPHISH_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=veilux_urls.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Request Settings ──────────────────────────────────────────────────────────
REQUEST_TIMEOUT=10
MAX_RETRIES=2
CACHE_TTL=3600

# ── URL Shortener ─────────────────────────────────────────────────────────────
URL_SHORTENER_BASE=http://veilux.local/
