# VEILUX-NG Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Optional API Keys ─────────────────────────────────────────────────────────
# IPinfo (https://ipinfo.io) — geolocation, company, ASN, privacy detection
IPINFO_TOKEN=

# Ipregistry (https://ipregistry.co) — 70+ attributes, threat levels, carrier
IPREGISTRY_API_KEY=

# MaxMind GeoIP2 Insights (https://www.maxmind.com) — fraud detection, ISP
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Spur (https://spur.us) — VPN / datacenter / residential proxy context
SPUR_API_TOKEN=

OPENPHISH_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=

# DomScan (https://domscan.io) — availability, valuation, DNS (10,000 free credits/month)
DOMSCAN_API_KEY=

# Ahrefs for Developers (https://ahrefs.com/api) — free domain rating endpoint
AHREFS_API_KEY=

# API Ninjas (https://api-ninjas.com) — free WHOIS + DNS fallback (non-commercial)
APININJAS_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_PATH=veilux_urls.db

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Request Settings ──────────────────────────────────────────────────────────
REQUEST_TIMEOUT=10
MAX_RETRIES=2
CACHE_TTL=3600

# ── URL Shortener ─────────────────────────────────────────────────────────────
URL_SHORTENER_BASE=http://veilux.local/
